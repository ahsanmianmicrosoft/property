// Prisma Schema for Enterprise Real Estate & Property Management Platform
// Database Provider: PostgreSQL

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
  PROPERTY_OWNER
  CUSTOMER
}

enum PropertyPurpose {
  SALE
  RENT
  LEASE
}

enum PropertyStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  FEATURED
  SOLD
  RENTED
  EXPIRED
  ARCHIVED
}

enum FurnishingStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FURNISHED
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  VIEWING_SCHEDULED
  NEGOTIATION
  CONVERTED
  LOST
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  GOOGLE
  REFERRAL
  WALK_IN
  PHONE
  OTHER
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  phone         String?
  avatar        String?
  role          UserRole       @default(CUSTOMER)
  company       String?
  bio           String?
  licenseNumber String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  properties    Property[]     @relation("OwnerProperties")
  assignedProperties Property[] @relation("AgentProperties")
  favorites     Favorite[]
  leads         Lead[]         @relation("AssignedAgent")
  appointments  Appointment[]  @relation("AgentAppointments")
  inquiries     Inquiry[]      @relation("CustomerInquiries")
  auditLogs     AuditLog[]
  reviews       Review[]

  @@index([email])
  @@index([role])
}

model PropertyType {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  icon        String?
  isActive    Boolean    @default(true)
  properties  Property[]
}

model Country {
  id        String     @id @default(uuid())
  name      String     @unique
  code      String     @unique
  provinces Province[]
}

model Province {
  id        String   @id @default(uuid())
  name      String
  countryId String
  country   Country  @relation(fields: [countryId], references: [id])
  cities    City[]

  @@unique([name, countryId])
}

model City {
  id         String   @id @default(uuid())
  name       String
  provinceId String
  province   Province @relation(fields: [provinceId], references: [id])
  areas      Area[]
  properties Property[]

  @@unique([name, provinceId])
}

model Area {
  id         String     @id @default(uuid())
  name       String
  cityId     String
  city       City       @relation(fields: [cityId], references: [id])
  societies  Society[]
  properties Property[]

  @@unique([name, cityId])
}

model Society {
  id         String     @id @default(uuid())
  name       String
  areaId     String
  area       Area       @relation(fields: [areaId], references: [id])
  properties Property[]
}

model Amenity {
  id         String            @id @default(uuid())
  name       String            @unique
  category   String            @default("general")
  icon       String
  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model Project {
  id             String         @id @default(uuid())
  slug           String         @unique
  name           String
  developer      String
  description    String
  startingPrice  Decimal        @db.Decimal(14, 2)
  currency       String         @default("PKR")
  status         String         @default("under_construction")
  totalUnits     Int            @default(0)
  availableUnits Int            @default(0)
  totalArea      String?
  completionDate DateTime?
  brochureUrl    String?
  images         ProjectImage[]
  properties     Property[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model ProjectImage {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
}

model Property {
  id              String            @id @default(uuid())
  slug            String            @unique
  title           String
  tagline         String?
  purpose         PropertyPurpose   @default(SALE)
  propertyTypeId  String
  propertyType    PropertyType      @relation(fields: [propertyTypeId], references: [id])
  price           Decimal           @db.Decimal(14, 2)
  currency        String            @default("PKR")
  bedrooms        Int               @default(0)
  bathrooms       Int               @default(0)
  areaSqFt        Decimal           @db.Decimal(10, 2)
  areaMarla       Decimal?          @db.Decimal(6, 2)
  floors          Int?              @default(1)
  yearBuilt       Int?
  furnishing      FurnishingStatus  @default(UNFURNISHED)
  parkingSpaces   Int               @default(0)
  description     String
  highlights      String[]
  features        String[]
  address         String
  cityId          String
  city            City              @relation(fields: [cityId], references: [id])
  areaId          String
  area            Area              @relation(fields: [areaId], references: [id])
  societyId       String?
  society         Society?          @relation(fields: [societyId], references: [id])
  latitude        Float?
  longitude       Float?
  status          PropertyStatus    @default(PENDING_APPROVAL)
  isFeatured      Boolean           @default(false)
  isVerified      Boolean           @default(false)
  rejectionReason String?
  viewsCount      Int               @default(0)
  ownerId         String?
  owner           User?             @relation("OwnerProperties", fields: [ownerId], references: [id])
  agentId         String?
  agent           User?             @relation("AgentProperties", fields: [agentId], references: [id])
  projectId       String?
  project         Project?          @relation(fields: [projectId], references: [id])
  images          PropertyImage[]
  amenities       PropertyAmenity[]
  inquiries       Inquiry[]
  appointments    Appointment[]
  favorites       Favorite[]
  reviews         Review[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([purpose])
  @@index([status])
  @@index([cityId])
  @@index([price])
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  isFeatured Boolean  @default(false)
  order      Int      @default(0)
}

model Lead {
  id                String         @id @default(uuid())
  name              String
  phone             String
  email             String
  source            LeadSource     @default(WEBSITE)
  agentId           String?
  agent             User?          @relation("AssignedAgent", fields: [agentId], references: [id])
  budget            Decimal?       @db.Decimal(14, 2)
  preferredLocation String?
  purpose           PropertyPurpose @default(SALE)
  notes             String?
  followUpDate      DateTime?
  status            LeadStatus     @default(NEW)
  activities        LeadActivity[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status])
  @@index([agentId])
}

model LeadActivity {
  id           String   @id @default(uuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentName    String
  activityType String
  details      String
  createdAt    DateTime @default(now())
}

model Inquiry {
  id               String   @id @default(uuid())
  propertyId       String
  property         Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  customerName     String
  customerEmail    String
  customerPhone    String
  customerId       String?
  customer         User?    @relation("CustomerInquiries", fields: [customerId], references: [id])
  preferredContact String   @default("phone")
  message          String
  status           String   @default("new")
  createdAt        DateTime @default(now())
}

model Appointment {
  id            String            @id @default(uuid())
  propertyId    String
  property      Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  customerName  String
  customerEmail String
  customerPhone String
  agentId       String
  agent         User              @relation("AgentAppointments", fields: [agentId], references: [id])
  date          DateTime
  timeSlot      String
  notes         String?
  status        AppointmentStatus @default(PENDING)
  createdAt     DateTime          @default(now())
}

model Favorite {
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, propertyId])
}

model BlogPost {
  id            String   @id @default(uuid())
  slug          String   @unique
  title         String
  excerpt       String
  content       String
  category      String
  tags          String[]
  featuredImage String
  authorName    String
  status        String   @default("published")
  publishedAt   DateTime @default(now())
}

model Review {
  id         String   @id @default(uuid())
  authorName String
  rating     Int      @default(5)
  comment    String
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id])
  status     String   @default("approved")
  createdAt  DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userName  String
  action    String
  entity    String
  entityId  String
  details   String
  ipAddress String?
  timestamp DateTime @default(now())
}
